*.bin


# ------------------------------------------------------------
# 6. DEVELOPMENT / TEMPORARY MODEL DIRECTORIES
# ------------------------------------------------------------

# NLP model cache / development artifacts
models_store/nlp/

# Deep-learning models are kept outside normal Git tracking
# because transformer weights can exceed GitHub's 100 MB limit.
models_store/dl/


